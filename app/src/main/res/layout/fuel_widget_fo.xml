<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cwgRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center"
    android:padding="8dp" android:background="#CC000000">

    <ImageView android:id="@+id/cwgIcon"
        android:layout_width="22dp" android:layout_height="22dp"
        android:src="@drawable/ic_widget_fo" android:contentDescription="Fuel Overlay" />

    <TextView android:id="@+id/cwgLabel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:text="F-O" android:textColor="#FFFFFF"
        android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>